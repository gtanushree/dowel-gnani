# Dowel local env. Copy to .env and fill in. Never commit .env.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GNANI_API_KEY=
SARVAM_API_KEY=
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=

# Speech runs on Gnani: Vachana hears, Timbre speaks.
# DOWEL_GNANI_VOICE=Pranav   # or Deepak, Kaveri, Shubhra
# DOWEL_GNANI_LANGUAGE=en-IN   # one locale; hi-IN for Hindi
# DOWEL_GNANI_MODEL=timbre-v2.5   # timbre-v3.0 needs one of its own voices, e.g. Avinash

# Only to compare against the older speech pair (Deepgram hears, Cartesia speaks):
# DOWEL_SPEECH=deepgram
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=

# Optional: keep your answers on this machine; write nothing to the repository.
# DOWEL_KEEP_LOCAL=1
# Optional: where `dowel brief --slack` posts.
# DOWEL_SLACK_WEBHOOK=https://hooks.slack.com/services/...
